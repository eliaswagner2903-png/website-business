{
  "name": "kundenseite",
  "private": true,
  "type": "module",
  "description": "Vorlage für eine Kundenseite: statisch + Cloudflare Pages Functions (Stripe, Kontakt).",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "html": "html-validate -c ../werkzeuge/.htmlvalidate.json public/*.html",
    "kopf": "python3 ../werkzeuge/kopf-pruefen.py public",
    "pruefen": "npm test && npm run html && npm run kopf",
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "html-validate": "^11.16.0"
  },
  "engines": {
    "node": ">=20"
  }
}
