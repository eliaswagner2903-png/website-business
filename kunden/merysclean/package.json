{
  "name": "merysclean",
  "private": true,
  "type": "module",
  "description": "Neubau Merys Clean: statisch (Generator bauen.mjs) + Cloudflare Pages Function (Angebotsformular).",
  "scripts": {
    "bauen": "node bauen.mjs",
    "test": "node --test tests/*.test.mjs",
    "html": "../../werkzeuge/node_modules/.bin/html-validate -c ../../werkzeuge/.htmlvalidate.json public/*.html",
    "kopf": "python3 ../../werkzeuge/kopf-pruefen.py public",
    "pruefen": "npm test && npm run html && npm run kopf",
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public"
  },
  "engines": {
    "node": ">=20"
  }
}
