{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/ops/log.py\" kurz", "timeout": 10 },
                  { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/werkzeuge/wissen-alter.mjs\" --kurz", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*([Hh]iggsfield|[Ee]leven[Ll]abs)",
        "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/werkzeuge/kosten-waechter.py\"", "timeout": 10, "onFailure": "block" } ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/werkzeuge/hook-pruefen.sh\"", "timeout": 60 } ]
      }
    ]
  }
}
